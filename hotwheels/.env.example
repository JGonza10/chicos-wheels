HOTWHEELS_USER_EMAIL=tu_correo@ejemplo.com
HOTWHEELS_USER_PASSWORD=tu_password
HOTWHEELS_CARD_NUMBER=4111111111111111
HOTWHEELS_CARD_EXPIRY=12/28
HOTWHEELS_CARD_CVV=123
HOTWHEELS_CARD_NAME=NOMBRE COMO APARECE EN LA TARJETA
HOTWHEELS_SHIP_FIRST_NAME=Nombre
HOTWHEELS_SHIP_LAST_NAME=Apellido
HOTWHEELS_SHIP_ADDRESS1=Calle y numero
HOTWHEELS_SHIP_ADDRESS2=Colonia/depto (opcional)
HOTWHEELS_SHIP_CITY=Ciudad
HOTWHEELS_SHIP_POSTAL_CODE=00000
HOTWHEELS_SHIP_STATE=Estado
HOTWHEELS_SHIP_PHONE=5500000000
HOTWHEELS_RFC=RFC a 13 o 12 caracteres
HOTWHEELS_MAX_QUANTITY=1
HOTWHEELS_SMTP_PASSWORD=tu_password_smtp
HOTWHEELS_TWILIO_SID=TU_TWILIO_SID
HOTWHEELS_TWILIO_TOKEN=TU_TWILIO_TOKEN

# Modo ensayo: 1 = recorre el checkout pero NO paga. Sin ella, "Comprar" paga de verdad.
# HOTWHEELS_DRY_RUN=1

# --- Panel suelto (python dashboard_bot.py, puerto 8000; solo para revisarlo) ---
# Lo normal es el panel dentro de Chicos Wheels (/bot), que pide su sesión.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Registro de compras en Chicos Wheels ---
# Cuenta donde se dan de alta las piezas compradas. Dentro del 02 basta el
# correo (la llamada se atiende en el mismo proceso); URL y contraseña solo
# hacen falta si el bot corre suelto.
COLLECTHUB_EMAIL=
COLLECTHUB_URL=http://localhost:3000
COLLECTHUB_PASSWORD=

# --- Telegram (2026-09-16) ---
# Opcional: crea un bot con @BotFather (te da el token) y habla con tu propio
# bot para obtener tu chat_id (ej. con @userinfobot). Tambien hay que poner
# "telegram": {"enabled": true} en config.json — vacio o enabled:false =
# canal apagado, el bot sigue notificando por email/WhatsApp como siempre.
HOTWHEELS_TELEGRAM_BOT_TOKEN=
HOTWHEELS_TELEGRAM_CHAT_ID=
