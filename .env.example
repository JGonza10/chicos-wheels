# Copia este archivo como .env y ajusta los valores.

# Puerto donde escucha el servidor
PORT=3000

# Llave para firmar las sesiones. GENERA UNA PROPIA, no uses esta.
# En la terminal: python -c "import secrets;print(secrets.token_hex(48))"
JWT_SECRET=cambia-esta-llave-por-una-larga-y-aleatoria

# Cuántos días dura una sesión antes de pedir contraseña otra vez
JWT_DIAS=30

# Ruta del archivo de base de datos
DB_FILE=./datos/collecthub.db

# En producción, el dominio exacto de tu frontend. Ej: https://collecthub.midominio.com
# CORS_ORIGIN=https://tudominio.com

# development activa la recarga automática; production obliga a definir JWT_SECRET
FLASK_ENV=development

# Identificación de piezas por foto (Claude, visión). Sin esta llave, el
# botón "Con foto" responde con un error claro en vez de tumbar la app —
# el resto de CollectHub funciona igual sin ella.
# ANTHROPIC_API_KEY=

# Modelo usado para identificar fotos. Opcional, este es el valor por defecto.
# IDENTIFICAR_MODELO=claude-sonnet-5

# Opcional: sube el límite de peticiones/día a pokemontcg.io (precio de
# mercado sugerido para cartas Pokémon). Sin ella, igual funciona con un
# límite más bajo. Se obtiene gratis en https://pokemontcg.io/
# POKEMONTCG_API_KEY=

# Landing page para clientes, en /tienda (archivos en la carpeta "landing page/").
# Correo de la cuenta cuyo inventario se muestra; sin esta variable, /tienda
# enseña piezas de ejemplo. Solo sale lo Disponible, sin costos ni datos internos.
LANDING_EMAIL=
# Contacto con clientes: solo Facebook (Messenger) e Instagram. Usuario o URL.
LANDING_FACEBOOK=
LANDING_INSTAGRAM=

# Asistente de la tienda (/tienda): funciona sin IA (búsqueda por palabras, gratis).
# ASISTENTE_IA=1 activa Claude para entender mensajes libres (necesita ANTHROPIC_API_KEY;
# cuesta centavos por mensaje). ASISTENTE_IA_TOPE = máximo de consultas a la IA por día.
ASISTENTE_IA=
ASISTENTE_IA_TOPE=300
# Modelo del asistente. Opcional, este es el valor por defecto.
# ASISTENTE_MODELO=claude-haiku-4-5

# Respaldo automático diario de la base de datos (activo por defecto).
# 1 lo apaga; las pruebas lo usan para no crear respaldos de mentira.
# COLLECTHUB_SIN_RESPALDO=1
# Aviso por Telegram de cada apartado / lista de espera desde la tienda (opcional).
CW_TELEGRAM_TOKEN=
CW_TELEGRAM_CHAT_ID=
